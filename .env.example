# HTTP
HTTP_ADDR=:8080
# порт на хосте, куда пробрасывается сервис в docker compose
HTTP_PORT=8080
LOG_LEVEL=info

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=tasks
MYSQL_USER=tasks
MYSQL_PASSWORD=tasks_password
MYSQL_ROOT_PASSWORD=root_password
MYSQL_EXPOSE_PORT=3306

# Redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_EXPOSE_PORT=6379

# JWT, секрет минимум 32 символа
JWT_SECRET=please-change-me-this-is-only-for-local-dev
JWT_TTL=24h

# Кеш списка задач и лимит запросов (0 выключает лимит)
TASKS_CACHE_TTL=5m
RATE_LIMIT_PER_MINUTE=120
